{
  "name": "mako-chat-client",
  "productName": "MAKO CHAT",
  "version": "1.0.0",
  "description": "MAKO CHAT \u2014 private institutional messaging desktop client (Electron + React)",
  "author": "MAKO CHAT project",
  "private": true,
  "license": "UNLICENSED",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:electron": "esbuild electron/main.ts electron/preload.ts --bundle --outdir=dist-electron --platform=node --format=cjs --external:electron",
    "build": "npm run typecheck && npm run build:electron && vite build",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.0",
    "matrix-js-sdk": "^45.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
